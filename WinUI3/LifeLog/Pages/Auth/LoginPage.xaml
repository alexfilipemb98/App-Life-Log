<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="LifeLog.Pages.Auth.LoginPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <ThemeShadow x:Name="SharedShadow" />
        <Storyboard x:Name="CardHoverEnterAnim">
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Name="CardHoverExitAnim">
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <ExponentialEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Page.Resources>

    <Grid x:Name="RootGrid">
        <!--<Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{ThemeResource SystemAccentColorLight2}" Offset="0.0" />
                <GradientStop Color="{ThemeResource ApplicationPageBackgroundThemeBrush}" Offset="0.5" />
                <GradientStop Color="{ThemeResource SystemAccentColorDark1}" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>-->

        <Border x:Name="LoginCard"
                HorizontalAlignment="Center" VerticalAlignment="Center" Width="400" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" 
                CornerRadius="16" Padding="40"
                Shadow="{StaticResource SharedShadow}" Translation="0,0,40"
                PointerEntered="LoginCard_PointerEntered" PointerExited="LoginCard_PointerExited">

            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="CardScale" CenterX="200" CenterY="250" />
                    <TranslateTransform x:Name="CardShakeTransform" />
                </TransformGroup>
            </Border.RenderTransform>

            <StackPanel Spacing="24">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="40" IsStaggeringEnabled="True" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="20" Background="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center">
                        <FontIcon Glyph="&#xECAD;" FontSize="30" Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Welcome Back" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Spacing="16">
                    <TextBox x:Name="EmailBox" Header="Email" PlaceholderText="your@email.com" InputScope="EmailNameOrAddress" TextChanged="ValidateInputs" CornerRadius="8" KeyDown="Input_KeyDown"/>

                    <StackPanel Spacing="4">
    
                        <!-- 1. O Título passa a estar de fora, separando as águas -->
                        <TextBlock Text="Password" FontSize="14" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Margin="0,0,0,4"/>
    
                       <!-- 2. A Grid agora abraça APENAS a caixa de texto e o botão -->
                        <Grid>
                            <PasswordBox x:Name="PassBox" 
                                         PlaceholderText="Password" 
                                         PasswordChanged="ValidateInputs" 
                                         PasswordRevealMode="Hidden" 
                                         GotFocus="PassBox_GotFocus" 
                                         LostFocus="PassBox_LostFocus" 
                                         KeyDown="PassBox_KeyDown" 
                                         CornerRadius="8" 
                                         Padding="12,8,44,8" 
                                         VerticalAlignment="Center"/>
        
                            <!-- 3. Adicionado Padding="0" e tamanho 34x34 para o ícone não cortar! -->
                            <ToggleButton x:Name="PassRevealToggle" 
                                          HorizontalAlignment="Right" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,6,0" 
                                          Width="34" Height="34" 
                                          Padding="0"
                                          CornerRadius="6"
                                          Background="Transparent" 
                                          BorderThickness="0" 
                                          Checked="PassRevealToggle_Checked" 
                                          Unchecked="PassRevealToggle_Unchecked"
                                          ToolTipService.ToolTip="Show password">
            
                                <FontIcon Glyph="&#xE890;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </ToggleButton>
                        </Grid>

                        <TextBlock x:Name="CapsLockWarning" 
                                   Text="Caps Lock is ON" 
                                   Foreground="{ThemeResource SystemFillColorCautionBrush}" 
                                   FontSize="12" 
                                   Visibility="Collapsed" 
                                   Margin="2,0,0,0" 
                                   FontWeight="Medium"/>
                    </StackPanel>

                    <TextBlock x:Name="ErrorMessage" Text="Invalid credentials." Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="12" Visibility="Collapsed" Margin="2,0,0,0" FontWeight="SemiBold"/>
                </StackPanel>

                <StackPanel Spacing="16">
                    <Button x:Name="SignInButton" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" Height="44" CornerRadius="8" Click="SignIn_Click">
                        <Grid>
                            <TextBlock x:Name="SignInText" Text="Sign In" FontWeight="SemiBold"/>
                            <ProgressRing x:Name="SignInSpinner" Visibility="Collapsed" IsActive="False" Width="24" Height="24" Foreground="{ThemeResource TextFillColorInverseBrush}"/>
                        </Grid>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <TextBlock Text="Don't have an account?" Opacity="0.7" VerticalAlignment="Center"/>
                        <HyperlinkButton Content="Sign up" FontSize="14" Padding="4,0" Click="GoToRegister_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>