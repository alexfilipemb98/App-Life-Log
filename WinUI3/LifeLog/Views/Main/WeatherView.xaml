<UserControl
    x:Class="LifeLog.Views.Main.WeatherView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,16,32,16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE74C;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Tools" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{ThemeResource TextFillColorDisabledBrush}" Margin="4,2,4,0"/>
                <FontIcon Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                <TextBlock Text="Advanced Weather" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Padding="0,32,0,32" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Width="1000" HorizontalAlignment="Center" Spacing="24">

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <AutoSuggestBox x:Name="CitySearchBox" PlaceholderText="Search City (e.g. Leiria, PT)" QueryIcon="Find" CornerRadius="8" QuerySubmitted="CitySearchBox_QuerySubmitted"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="LastUpdateLabel" Text="Waiting for search..." VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button Click="RefreshBtn_Click" Content="&#xE72C;" FontFamily="Segoe Fluent Icons" CornerRadius="8" ToolTipService.ToolTip="Refresh Data"/>
                    </StackPanel>
                </Grid>

                <Border CornerRadius="16" Padding="40" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0284C7" Offset="0.0"/>
                            <GradientStop Color="#075985" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="CityTitle" Text="CITY, COUNTRY" Foreground="White" FontSize="16" FontWeight="Black" Opacity="0.8" CharacterSpacing="100"/>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <TextBlock x:Name="TempLabel" Text="--" Foreground="White" FontSize="84" FontWeight="Bold" Margin="0,-15,0,0"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="°C" Foreground="White" FontSize="28" FontWeight="SemiBold" Opacity="0.6"/>
                                    <TextBlock x:Name="FeelsLikeLabel" Text="Feels like --°C" Foreground="White" FontSize="14" Opacity="0.8"/>
                                </StackPanel>
                            </StackPanel>
                            <TextBlock x:Name="ConditionText" Text="Please search a city" Foreground="White" FontSize="20" FontWeight="Medium" TextWrapping="Wrap"/>
                        </StackPanel>

                        <FontIcon x:Name="MainWeatherIcon" Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="120" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.9"/>
                    </Grid>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                    <StackPanel Spacing="20">
                        <TextBlock Text="5-DAY FORECAST" FontSize="10" FontWeight="Black" Opacity="0.6" CharacterSpacing="150"/>
                        
                        <ItemsControl x:Name="DailyForecastList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="12" Padding="20" Width="170">
                                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DayName}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <FontIcon Glyph="{Binding IconGlyph}" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{ThemeResource SystemAccentColor}" HorizontalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding MaxTempStr}" FontSize="18" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding MinTempStr}" FontSize="18" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                    <StackPanel Spacing="20">
                        <TextBlock Text="24-HOUR FORECAST" FontSize="10" FontWeight="Black" Opacity="0.6" CharacterSpacing="150"/>
                        
                        <Canvas x:Name="ForecastCanvas" Height="150" HorizontalAlignment="Stretch" Margin="20,20,20,30"/>
                    </StackPanel>
                </Border>

                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="ATMOSPHERE" FontSize="10" FontWeight="Black" Opacity="0.6"/>
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="CloudinessText" Text="Cloudiness: --%" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PressureText" Text="Pressure: -- hPa" FontSize="14" Opacity="0.8"/>
                                <TextBlock x:Name="HumidityText" Text="Humidity: --%" FontSize="14" Opacity="0.8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="WIND" FontSize="10" FontWeight="Black" Opacity="0.6"/>
                            <FontIcon Glyph="&#xE724;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Left" FontSize="24" Foreground="{ThemeResource SystemAccentColor}"/>
                            <TextBlock x:Name="WindSpeedText" Text="-- km/h" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="WindDirText" Text="Direction: --" FontSize="12" Opacity="0.6"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="SUNRISE &amp; SUNSET" FontSize="10" FontWeight="Black" Opacity="0.6" CharacterSpacing="150"/>
                            <Grid ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE706;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#FFB900"/>
                                    <TextBlock x:Name="SunriseTimeText" Text="--:--" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE708;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="#FF8C00"/>
                                    <TextBlock x:Name="SunsetTimeText" Text="--:--" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>