<UserControl
    x:Class="LifeLog.Views.Main.NotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Main" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{ThemeResource TextFillColorDisabledBrush}" Margin="4,2,4,0"/>
                
                <Border Background="{ThemeResource SystemAccentColorLight3}" CornerRadius="4" Padding="6,4">
                    <FontIcon Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                </Border>
                <TextBlock Text="My Notes" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" Margin="24,24,24,32" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/> <ColumnDefinition Width="*"/>   </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="16" Margin="0,0,0,16">
                    <Button x:Name="NewNoteBtn" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="44" CornerRadius="8" Click="NewNoteBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="14"/>
                            <TextBlock Text="New Note" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                    
                    <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find" PlaceholderText="Search notes..." TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <Border Grid.Row="1" Background="{ThemeResource LayerFillColorAltBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="8">
                    <ListView x:Name="NotesList" SelectionChanged="NotesList_SelectionChanged" ShowsScrollingPlaceholders="False">
                        
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition/>
                            </TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="CornerRadius" Value="8"/>
                                <Setter Property="Padding" Value="12,12,12,12"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Content}" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DateStr}" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </Grid>
            <Border x:Name="EditorPanel" Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                    BorderThickness="1" CornerRadius="16" Padding="15"
                    Visibility="Collapsed"> 
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TitleBox" Grid.Column="0" PlaceholderText="Note Title"
                                 FontSize="24" FontWeight="Bold" BorderThickness="0" Background="Transparent" 
                                 TextChanged="Editor_TextChanged" Margin="0,0,15,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <TextBlock x:Name="SaveStatusText" Text="Saved" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                            <Button x:Name="DeleteBtn" Click="DeleteBtn_Click" Background="Transparent" BorderThickness="0" CornerRadius="6" Height="40" Width="40" ToolTipService.ToolTip="Delete Note">
                                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                  <CommandBar Grid.Row="1" Background="Transparent" DefaultLabelPosition="Collapsed" Margin="0,0,0,10" IsOpen="False">
                        
                        <AppBarButton Icon="Undo" ToolTipService.ToolTip="Undo (Ctrl+Z)" Click="UndoBtn_Click"/>
                        <AppBarButton Icon="Redo" ToolTipService.ToolTip="Redo (Ctrl+Y)" Click="RedoBtn_Click"/>
                        <AppBarSeparator/>

                        <AppBarElementContainer VerticalAlignment="Center" Margin="4,0">
                            <ComboBox x:Name="FontSizeBox" Width="72" SelectionChanged="FontSizeBox_SelectionChanged" ToolTipService.ToolTip="Font Size">
                                <x:String>12</x:String>
                                <x:String>14</x:String>
                                <x:String>16</x:String>
                                <x:String>18</x:String>
                                <x:String>24</x:String>
                                <x:String>32</x:String>
                                <x:String>48</x:String>
                            </ComboBox>
                        </AppBarElementContainer>

                        <AppBarSeparator/>
                        
                        <AppBarButton Icon="Bold" ToolTipService.ToolTip="Bold (Ctrl+B)" Click="BoldBtn_Click"/>
                        <AppBarButton Icon="Italic" ToolTipService.ToolTip="Italic (Ctrl+I)" Click="ItalicBtn_Click"/>
                        <AppBarButton Icon="Underline" ToolTipService.ToolTip="Underline (Ctrl+U)" Click="UnderlineBtn_Click"/>
                        
                        <AppBarButton ToolTipService.ToolTip="Strikethrough" Click="StrikeBtn_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xEDE0;" FontFamily="Segoe Fluent Icons"/>
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarSeparator/>
                        
                        <AppBarButton ToolTipService.ToolTip="Align Left" Click="AlignLeftBtn_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8E4;" FontFamily="Segoe Fluent Icons"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton ToolTipService.ToolTip="Align Center" Click="AlignCenterBtn_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8E3;" FontFamily="Segoe Fluent Icons"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                        <AppBarButton ToolTipService.ToolTip="Align Right" Click="AlignRightBtn_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE8E5;" FontFamily="Segoe Fluent Icons"/>
                            </AppBarButton.Icon>
                        </AppBarButton>

                        <AppBarSeparator/>
                        
                        <AppBarButton Icon="List" ToolTipService.ToolTip="Bullet List" Click="ListBtn_Click"/>

                        <AppBarSeparator/>
                        
                        <AppBarButton Icon="FontColor" ToolTipService.ToolTip="Text Color">
                            <AppBarButton.Flyout>
                                <Flyout>
                                    <ColorPicker ColorChanged="TextColorPicker_ColorChanged" ColorSpectrumShape="Ring" IsMoreButtonVisible="False" IsColorSliderVisible="True" IsAlphaEnabled="False"/>
                                </Flyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        
                        <AppBarButton Icon="Highlight" ToolTipService.ToolTip="Highlight Color">
                            <AppBarButton.Flyout>
                                <Flyout>
                                    <ColorPicker ColorChanged="HighlightColorPicker_ColorChanged" ColorSpectrumShape="Ring" IsMoreButtonVisible="False" IsColorSliderVisible="True" IsAlphaEnabled="False"/>
                                </Flyout>
                            </AppBarButton.Flyout>
                        </AppBarButton>
                        
                        <AppBarButton ToolTipService.ToolTip="Clear Formatting" Click="ClearFormatBtn_Click">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE894;" FontFamily="Segoe Fluent Icons"/>
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar>

                    <RichEditBox x:Name="ContentBox" Grid.Row="2" PlaceholderText="Start typing your ideas here..." 
                                 BorderThickness="0" Background="Transparent" Padding="5"
                                 FontSize="16" TextChanged="RichEditor_TextChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
            <StackPanel x:Name="EmptyStatePanel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                <FontIcon Glyph="&#xE70B;" FontFamily="Segoe Fluent Icons" FontSize="64" Foreground="{ThemeResource TextFillColorDisabledBrush}"/>
                <TextBlock Text="Select a note or create a new one" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            
        </Grid>
    </Grid>
</UserControl>