<UserControl
 x:Class="LifeLog.Views.Main.NotesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <RowDefinition Height="Auto"/> <RowDefinition Height="*"/>    </Grid.RowDefinitions>

        <Border x:Name="SearchBar" Grid.Row="0" Visibility="Collapsed" 
                Background="{ThemeResource LayerFillColorDefaultBrush}" 
                CornerRadius="8" Margin="8,8,8,0" Padding="8"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="Localizar" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="&#xE74A;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Pesquisar"/>
                    <Button Content="&#xE70D;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Anterior"/>
                    <Button Content="&#xE70E;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Próximo"/>
                    <Button Click="CloseSearch_Click" Content="&#xE711;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Fechar"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="8,8,8,4" Padding="4" CornerRadius="8" 
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal" Spacing="4">
    
    <AppBarSeparator/>

    <ToggleButton x:Name="BtnBold" Content="&#xE8DD;" FontFamily="Segoe Fluent Icons" Click="Bold_Click" ToolTipService.ToolTip="Negrito (Ctrl+B)" Background="Transparent" BorderThickness="0"/>
    <ToggleButton x:Name="BtnItalic" Content="&#xE8DB;" FontFamily="Segoe Fluent Icons" Click="Italic_Click" ToolTipService.ToolTip="Itálico (Ctrl+I)" Background="Transparent" BorderThickness="0"/>
    <ToggleButton x:Name="BtnStrikethrough" Content="&#xEDE0;" FontFamily="Segoe Fluent Icons" Click="Strikethrough_Click" ToolTipService.ToolTip="Rasurado" Background="Transparent" BorderThickness="0"/>
    
    <DropDownButton Content="&#xE8D3;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Cor do tipo de letra">
        <DropDownButton.Flyout>
            <Flyout>
                <StackPanel Spacing="8">
                    <Button Content="Automático" HorizontalAlignment="Stretch" Click="AutoTextColor_Click"/>
                    <GridView SelectionChanged="TextColor_SelectionChanged" Width="140" SelectionMode="Single">
                        <GridViewItem Background="#EF5350" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#FF9800" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#FFEB3B" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#8BC34A" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#4CAF50" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#03A9F4" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#3F51B5" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#9C27B0" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                    </GridView>
                </StackPanel>
            </Flyout>
        </DropDownButton.Flyout>
    </DropDownButton>

    <DropDownButton Content="&#xE7E6;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Realçar">
        <DropDownButton.Flyout>
            <Flyout>
                <StackPanel Spacing="8">
                    <Button Content="Sem realce" HorizontalAlignment="Stretch" Click="NoHighlightColor_Click"/>
                    <GridView SelectionChanged="HighlightColor_SelectionChanged" Width="140" SelectionMode="Single">
                        <GridViewItem Background="#FFCDD2" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#FFE0B2" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#FFF9C4" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#DCEDC8" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#C8E6C9" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#B3E5FC" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#C5CAE9" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                        <GridViewItem Background="#E1BEE7" Width="24" Height="24" Margin="2" CornerRadius="4"/>
                    </GridView>
                </StackPanel>
            </Flyout>
        </DropDownButton.Flyout>
    </DropDownButton>

    <AppBarSeparator/>

    <Button Content="&#xE71B;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Inserir ligação"/>
    <Button Content="&#xE943;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Bloco de código (Ctrl+Shift+B)"/>
    
    <Button Click="Quote_Click" ToolTipService.ToolTip="Citação (Ctrl+Alt+4)" Background="Transparent" BorderThickness="0">
        <TextBlock Text="&#x201D;" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Margin="0,-4,0,0"/>
    </Button>

    <AppBarSeparator/>
    
    <Button Click="ClearFormatting_Click" Content="&#xE8D8;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Limpar formatação (Ctrl+Barra de Espaço)"/>
    <Button Click="ToggleSearch_Click" Content="&#xE721;" FontFamily="Segoe Fluent Icons" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Localizar"/>
    
</StackPanel>
        </Border>

        <RichEditBox x:Name="Editor" Grid.Row="2" 
                     Margin="8,4,8,8" 
                     BorderThickness="0"
                     Background="Transparent"
                     PlaceholderText="Escreva a sua mensagem aqui..."
                     TextWrapping="Wrap" 
                     AcceptsReturn="True"/>
    </Grid>
</UserControl>