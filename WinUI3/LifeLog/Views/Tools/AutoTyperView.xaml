<UserControl
    x:Class="LifeLog.Views.Tools.AutoTyperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE74C;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Tools" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{ThemeResource TextFillColorDisabledBrush}" Margin="4,2,4,0"/>
                
                <Border Background="{ThemeResource SystemAccentColorLight3}" CornerRadius="4" Padding="6,4">
                    <FontIcon Glyph="&#xE765;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                </Border>
                <TextBlock Text="Ghost Writer" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center" Spacing="24" Margin="24,40,24,64">
                
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition FromVerticalOffset="30" IsStaggeringEnabled="True"/>
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                        BorderThickness="1" CornerRadius="16" Padding="32">
                    <StackPanel Spacing="24">
                        
                        <StackPanel Spacing="8">
                            <TextBlock Text="Text to Type" FontWeight="SemiBold" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" Height="200" CornerRadius="8" PlaceholderText="Paste or type the text you want the ghost to write..."/>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="-32,0"/>

                        <Grid ColumnSpacing="32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4">
                                <Grid>
                                    <TextBlock Text="Start Delay" FontWeight="Medium"/>
                                    <TextBlock x:Name="DelayLabel" Text="3s" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                                </Grid>
                                <Slider x:Name="DelaySlider" Minimum="0" Maximum="10" Value="3" ValueChanged="DelaySlider_ValueChanged"/>
                                <TextBlock Text="Time to switch windows" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <Grid>
                                    <TextBlock Text="Typing Speed" FontWeight="Medium"/>
                                    <TextBlock x:Name="SpeedLabel" Text="50ms" HorizontalAlignment="Right" FontWeight="Bold" Foreground="{ThemeResource SystemAccentColor}"/>
                                </Grid>
                                <Slider x:Name="SpeedSlider" Minimum="10" Maximum="200" Value="50" IsDirectionReversed="True" ValueChanged="SpeedSlider_ValueChanged"/>
                                <TextBlock Text="Delay between keystrokes" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button x:Name="StartBtn" Grid.Column="0" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Height="48" CornerRadius="8" Click="StartBtn_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
                                <TextBlock Text="Start Ghost Writer" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="StopBtn" Grid.Column="1" Height="48" Width="48" CornerRadius="8" IsEnabled="False" Click="StopBtn_Click" Background="{ThemeResource ControlFillColorDefaultBrush}" ToolTipService.ToolTip="Emergency Stop">
                            <FontIcon Glyph="&#xE71A;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                        </Button>
                    </Grid>

                    <Border x:Name="StatusBadge" Background="{ThemeResource SystemFillColorSuccessBrush}" CornerRadius="8" Padding="16,8" HorizontalAlignment="Center" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="StatusIcon" Glyph="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="White"/>
                            <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>