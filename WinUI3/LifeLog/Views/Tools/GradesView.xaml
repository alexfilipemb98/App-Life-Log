<UserControl
    x:Class="LifeLog.Views.Tools.GradesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:Canvas="using:Windows.Globalization.NumberFormatting"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="24,16" Background="Transparent" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE74C;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <TextBlock Text="Tools" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                <FontIcon Glyph="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="10" Foreground="{ThemeResource TextFillColorDisabledBrush}" Margin="4,2,4,0"/>

                <Border Background="{ThemeResource SystemAccentColorLight3}" CornerRadius="4" Padding="6,4">
                    <FontIcon Glyph="&#xE1D0;" FontFamily="Segoe Fluent Icons" FontSize="14" Foreground="{ThemeResource SystemAccentColor}"/>
                </Border>
                <TextBlock Text="Grades Calculator" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,16,0">
            <StackPanel MaxWidth="1200" HorizontalAlignment="Center" Spacing="24" Margin="24,32,24,64">

                <Border CornerRadius="16" Padding="32,40" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Margin="0,0,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{ThemeResource SystemAccentColor}" Offset="0.0"/>
                            <GradientStop Color="{ThemeResource SystemAccentColorDark1}" Offset="0.5"/>
                            <GradientStop Color="{ThemeResource SystemAccentColorDark3}" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Text="FINAL SCORE" Foreground="White" Opacity="0.8" FontSize="12" FontWeight="Bold" CharacterSpacing="80" Margin="4,0,0,0"/>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                                <TextBlock x:Name="FinalGradeRoundedLabel" Text="0" Foreground="White" FontSize="80" FontWeight="Bold" LineHeight="80"/>
                                <TextBlock Text="/ 20" Foreground="White" Opacity="0.6" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.9" Margin="4,0,0,0">
                                <TextBlock Text="Exact Average:" Foreground="White" FontSize="14" FontWeight="Medium" Opacity="0.8"/>
                                <TextBlock x:Name="FinalGradeDecimalLabel" Text="0.00" Foreground="White" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="StatusBorder" Background="White" Opacity="0.2" CornerRadius="24" Padding="24,12" BorderThickness="1" BorderBrush="#40FFFFFF">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="StatusIcon" Glyph="&#xE823;" FontFamily="Segoe Fluent Icons" Foreground="White" FontSize="16"/>
                                    <TextBlock x:Name="StatusLabel" Text="WAITING" Foreground="White" FontSize="16" FontWeight="Bold" CharacterSpacing="20"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <TextBlock Text="Assessments" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" FontSize="16" VerticalAlignment="Center"/>

                    <Button x:Name="AddRowBtn" Click="AddRowBtn_Click" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}" Height="36" Padding="16,0" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12"/>
                            <TextBlock Text="Add Assessment" FontWeight="Medium" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ListView x:Name="GradesList" SelectionMode="None" IsItemClickEnabled="False">

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,12"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition/>
                            <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="20"/>
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="8" 
                                    Padding="20,16">

                                <Grid ColumnSpacing="24" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Text="Assessment Name" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBox PlaceholderText="e.g. Midterm Exam" 
                                                 Text="{Binding Name, Mode=TwoWay}" 
                                                 BorderThickness="0,0,0,1" 
                                                 Background="Transparent" 
                                                 Padding="0,4" 
                                                 CornerRadius="0"/>
                                    </StackPanel>

                                    <NumberBox Grid.Column="1" 
                                               Header="Grade (0-20)" 
                                               Value="{Binding Grade, Mode=TwoWay}" 
                                               SmallChange="0.5" 
                                               LargeChange="1.0"
                                               Minimum="0" Maximum="20"
                                               SpinButtonPlacementMode="Inline" 
                                               CornerRadius="6">
                                        <NumberBox.NumberFormatter>
                                            <Canvas:DecimalFormatter FractionDigits="2" NumberRounder="{x:Null}"/>
                                        </NumberBox.NumberFormatter>
                                    </NumberBox>

                                    <NumberBox Grid.Column="2" 
                                               Header="Weight (%)" 
                                               Value="{Binding Weight, Mode=TwoWay}" 
                                               SmallChange="5" 
                                               LargeChange="10"
                                               Minimum="0" Maximum="100"
                                               SpinButtonPlacementMode="Inline" 
                                               CornerRadius="6">
                                        <NumberBox.NumberFormatter>
                                            <Canvas:DecimalFormatter FractionDigits="1" NumberRounder="{x:Null}"/>
                                        </NumberBox.NumberFormatter>
                                    </NumberBox>

                                    <Button Grid.Column="3" 
                                            Click="DeleteRow_Click" 
                                            VerticalAlignment="Bottom" 
                                            Background="Transparent" 
                                            BorderThickness="0" 
                                            CornerRadius="6" 
                                            Width="40" Height="40"
                                            ToolTipService.ToolTip="Delete Assessment">
                                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <InfoBar x:Name="WeightWarning" 
                         Title="Weight Balance" 
                         Message="The total weight of your assessments should equal 100%." 
                         IsOpen="True" 
                         IsClosable="False" 
                         Severity="Informational" 
                         CornerRadius="8"
                         Margin="0,8,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>