<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ForceDesignerDpiUnaware>true</ForceDesignerDpiUnaware>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <PackageIcon>Icon128.png</PackageIcon>
    <Version>2026.1.0</Version>
    <AssemblyVersion>2026.0.0.0</AssemblyVersion>
    <FileVersion>2026.1.0.19</FileVersion>
    <ApplicationIcon>LifeLog.ico</ApplicationIcon>
    <SignAssembly>False</SignAssembly>
    <NeutralLanguage>en-GB</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="LifeLog.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="E:\Assests\Imgs\Icon128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Win.BonusSkins" Version="25.2.3" />
    <PackageReference Include="DevExpress.Win.Design" Version="25.2.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Data\LifeLog.Data.World\LifeLog.Data.World.csproj" />
    <ProjectReference Include="..\Data\LifeLog.Data\LifeLog.Data.csproj" />
    <ProjectReference Include="..\Services\LifeLog.Services.Api\LifeLog.Services.Api.csproj" />
    <ProjectReference Include="..\Services\LifeLog.Services.Weather\LifeLog.Services.Weather.csproj" />
    <ProjectReference Include="..\Services\LifeLog.Services\LifeLog.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\Icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="if /I &quot;$(ConfigurationName)&quot;==&quot;Release&quot; (&#xD;&#xA;    del /Q /F *.pdb 2&gt;nul&#xD;&#xA;    del /Q /F D*.xml 2&gt;nul&#xD;&#xA;)" />
  </Target>

</Project>